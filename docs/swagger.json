{
    "swagger": "2.0",
    "info": {
        "description": "High-concurrency ticket booking backend. A seat can never be booked twice:\nPostgreSQL's UNIQUE(show_id, seat_id) constraint is the final authority.",
        "title": "SeatLock API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/healthz": {
            "get": {
                "description": "Returns 200 while the process is running. Does not check dependencies.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Liveness check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.StatusResponse"
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "description": "Returns 200 only if PostgreSQL answers a ping within 1 second, otherwise 503.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Readiness check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.StatusResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/httpapi.StatusResponse"
                        }
                    }
                }
            }
        },
        "/v1/bookings": {
            "post": {
                "description": "Books one seat directly (no holds in Phase 1). If several users book the\nsame seat at once, exactly one gets 201 and the rest get 409.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "bookings"
                ],
                "summary": "Book a seat",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Who is booking",
                        "name": "X-User-ID",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Seat to book",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.CreateBookingRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/httpapi.BookingResponse"
                        }
                    },
                    "400": {
                        "description": "Bad input or missing X-User-ID",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Show or seat not found",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Seat already booked",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/bookings/{bookingID}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "bookings"
                ],
                "summary": "Get a booking",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Booking ID",
                        "name": "bookingID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.BookingResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/shows": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "shows"
                ],
                "summary": "List shows",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ShowListResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/shows/{showID}/seats": {
            "get": {
                "description": "Every seat of the show with its price and status (AVAILABLE or BOOKED).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "shows"
                ],
                "summary": "Seat map of a show",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Show ID",
                        "name": "showID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.SeatMapResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "httpapi.BookingResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string",
                    "example": "2026-11-07T10:00:00Z"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "seat_id": {
                    "type": "integer",
                    "example": 7
                },
                "show_id": {
                    "type": "integer",
                    "example": 1
                },
                "user_id": {
                    "type": "string",
                    "example": "user-42"
                }
            }
        },
        "httpapi.CreateBookingRequest": {
            "type": "object",
            "properties": {
                "seat_id": {
                    "type": "integer",
                    "example": 7
                },
                "show_id": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "httpapi.ErrorBody": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "SEAT_ALREADY_BOOKED"
                },
                "message": {
                    "type": "string",
                    "example": "this seat has already been booked"
                }
            }
        },
        "httpapi.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/httpapi.ErrorBody"
                }
            }
        },
        "httpapi.SeatMapResponse": {
            "type": "object",
            "properties": {
                "seats": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/httpapi.SeatResponse"
                    }
                },
                "show_id": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "httpapi.SeatResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 7
                },
                "label": {
                    "type": "string",
                    "example": "A7"
                },
                "price_paise": {
                    "type": "integer",
                    "example": 25000
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "AVAILABLE",
                        "BOOKED"
                    ],
                    "example": "AVAILABLE"
                }
            }
        },
        "httpapi.ShowListResponse": {
            "type": "object",
            "properties": {
                "shows": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/httpapi.ShowResponse"
                    }
                }
            }
        },
        "httpapi.ShowResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "starts_at": {
                    "type": "string",
                    "example": "2027-01-25T13:30:00Z"
                },
                "title": {
                    "type": "string",
                    "example": "Coldplay Live"
                },
                "venue": {
                    "type": "string",
                    "example": "DY Patil Stadium, Navi Mumbai"
                }
            }
        },
        "httpapi.StatusResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        }
    }
}