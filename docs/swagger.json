{
    "swagger": "2.0",
    "info": {
        "description": "High-concurrency ticket booking backend. A seat can never be booked twice:\nPostgreSQL's UNIQUE(show_id, seat_id) constraint is the final authority.",
        "title": "SeatLock API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/healthz": {
            "get": {
                "description": "Returns 200 while the process is running. Does not check dependencies.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Liveness check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.StatusResponse"
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "description": "Reports Postgres and Redis. Returns 200 whenever Postgres answers within 1s,\neven if Redis is down; returns 503 only when Postgres is down.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Readiness check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ReadinessResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ReadinessResponse"
                        }
                    }
                }
            }
        },
        "/v1/bookings": {
            "post": {
                "description": "Charges the seat price for the user's active hold and turns it into a booking.\nRequires an Idempotency-Key: sending the same request again with the same key\nreturns the stored response (header Idempotent-Replayed: true) and never charges twice.\nUses PostgreSQL only, so it works while Redis is down.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "bookings"
                ],
                "summary": "Confirm a hold: pay, then book",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Owner of the hold",
                        "name": "X-User-ID",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Unique key for this confirm (1-64 characters)",
                        "name": "Idempotency-Key",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Hold to confirm",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.ConfirmBookingRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/httpapi.BookingResponse"
                        }
                    },
                    "400": {
                        "description": "Bad input, missing X-User-ID or Idempotency-Key",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "402": {
                        "description": "PAYMENT_DECLINED (hold kept; retry with a new key)",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "HOLD_NOT_FOUND (also for another user's hold)",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "HOLD_ALREADY_USED, SEAT_ALREADY_BOOKED or REQUEST_IN_PROGRESS",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "410": {
                        "description": "HOLD_EXPIRED (error.payment = REFUNDED / REFUND_PENDING if money was taken)",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "IDEMPOTENCY_KEY_REUSED",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "SERVICE_BUSY",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "504": {
                        "description": "PAYMENT_PENDING (outcome unknown; retry with the SAME key)",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/bookings/{bookingID}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "bookings"
                ],
                "summary": "Get a booking",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Booking ID",
                        "name": "bookingID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.BookingResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Database busy",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/holds": {
            "post": {
                "description": "Reserves a seat for the user for 5 minutes. Returns 201 for a new hold, or 200\nwith the same hold if this user already holds the seat (safe to retry).\nIf the seat lock (Redis) is unavailable, no hold is created: 503 LOCK_UNAVAILABLE.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "holds"
                ],
                "summary": "Hold a seat",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Who is holding",
                        "name": "X-User-ID",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Seat to hold",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.CreateHoldRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Existing hold of this user",
                        "schema": {
                            "$ref": "#/definitions/httpapi.HoldResponse"
                        }
                    },
                    "201": {
                        "description": "New hold",
                        "schema": {
                            "$ref": "#/definitions/httpapi.HoldResponse"
                        }
                    },
                    "400": {
                        "description": "Bad input or missing X-User-ID",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Show or seat not found",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "SEAT_HELD or SEAT_ALREADY_BOOKED",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "LOCK_UNAVAILABLE or SERVICE_BUSY",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/holds/{holdID}": {
            "delete": {
                "description": "Releases the user's active hold so others can take the seat. Works even when\nRedis is down (PostgreSQL is updated; the Redis lock then expires by TTL).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "holds"
                ],
                "summary": "Cancel a hold",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Owner of the hold",
                        "name": "X-User-ID",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Hold ID",
                        "name": "holdID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.HoldResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "HOLD_NOT_FOUND (also for another user's hold)",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "HOLD_ALREADY_USED",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "410": {
                        "description": "HOLD_EXPIRED",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "SERVICE_BUSY",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/shows": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "shows"
                ],
                "summary": "List shows",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ShowListResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Database busy",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/shows/{showID}/seats": {
            "get": {
                "description": "Every seat of the show with its price and status (AVAILABLE, HELD or BOOKED),\ncomputed from PostgreSQL only.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "shows"
                ],
                "summary": "Seat map of a show",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Show ID",
                        "name": "showID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.SeatMapResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Database busy",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "httpapi.BookingResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string",
                    "example": "2026-11-07T10:00:00Z"
                },
                "hold_id": {
                    "type": "integer",
                    "example": 12
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "seat_id": {
                    "type": "integer",
                    "example": 7
                },
                "show_id": {
                    "type": "integer",
                    "example": 1
                },
                "user_id": {
                    "type": "string",
                    "example": "user-42"
                }
            }
        },
        "httpapi.ConfirmBookingRequest": {
            "type": "object",
            "properties": {
                "hold_id": {
                    "type": "integer",
                    "example": 12
                }
            }
        },
        "httpapi.CreateHoldRequest": {
            "type": "object",
            "properties": {
                "seat_id": {
                    "type": "integer",
                    "example": 7
                },
                "show_id": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "httpapi.ErrorBody": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "SEAT_ALREADY_BOOKED"
                },
                "message": {
                    "type": "string",
                    "example": "this seat has already been booked"
                },
                "payment": {
                    "description": "Payment is only set on 410 HOLD_EXPIRED when money had been taken:\n\"REFUNDED\" or \"REFUND_PENDING\".",
                    "type": "string",
                    "example": "REFUNDED"
                }
            }
        },
        "httpapi.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/httpapi.ErrorBody"
                }
            }
        },
        "httpapi.HoldResponse": {
            "type": "object",
            "properties": {
                "expires_at": {
                    "type": "string",
                    "example": "2026-11-07T10:05:00Z"
                },
                "hold_id": {
                    "type": "integer",
                    "example": 12
                },
                "seat_id": {
                    "type": "integer",
                    "example": 7
                },
                "seconds_left": {
                    "type": "integer",
                    "example": 300
                },
                "show_id": {
                    "type": "integer",
                    "example": 1
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "ACTIVE",
                        "CONSUMED",
                        "RELEASED",
                        "EXPIRED"
                    ],
                    "example": "ACTIVE"
                },
                "user_id": {
                    "type": "string",
                    "example": "user-42"
                }
            }
        },
        "httpapi.ReadinessResponse": {
            "type": "object",
            "properties": {
                "postgres": {
                    "type": "string",
                    "enum": [
                        "up",
                        "down"
                    ],
                    "example": "up"
                },
                "redis": {
                    "type": "string",
                    "enum": [
                        "up",
                        "down"
                    ],
                    "example": "up"
                }
            }
        },
        "httpapi.SeatMapResponse": {
            "type": "object",
            "properties": {
                "seats": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/httpapi.SeatResponse"
                    }
                },
                "show_id": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "httpapi.SeatResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 7
                },
                "label": {
                    "type": "string",
                    "example": "A7"
                },
                "price_paise": {
                    "type": "integer",
                    "example": 25000
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "AVAILABLE",
                        "HELD",
                        "BOOKED"
                    ],
                    "example": "AVAILABLE"
                }
            }
        },
        "httpapi.ShowListResponse": {
            "type": "object",
            "properties": {
                "shows": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/httpapi.ShowResponse"
                    }
                }
            }
        },
        "httpapi.ShowResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "starts_at": {
                    "type": "string",
                    "example": "2027-01-25T13:30:00Z"
                },
                "title": {
                    "type": "string",
                    "example": "Coldplay Live"
                },
                "venue": {
                    "type": "string",
                    "example": "DY Patil Stadium, Navi Mumbai"
                }
            }
        },
        "httpapi.StatusResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        }
    }
}