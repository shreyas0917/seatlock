      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (check) (seatlock_invariant_violations)",
          "legendFormat": "{{check}}",
          "refId": "A",
          "range": true,
          "instant": false
