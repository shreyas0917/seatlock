      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(seatlock_http_request_duration_seconds_bucket{route=\"/v1/holds\",method=\"POST\"}[1m])))",
          "legendFormat": "holds p50",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(seatlock_http_request_duration_seconds_bucket{route=\"/v1/holds\",method=\"POST\"}[1m])))",
          "legendFormat": "holds p95",
          "refId": "B",
          "range": true,
          "instant": false
        },
