# Copy this file to .env and adjust if needed:  cp .env.example .env
# The Makefile and docker compose both read .env automatically.

# --- Postgres container ---
POSTGRES_USER=seatlock
POSTGRES_PASSWORD=seatlock
POSTGRES_DB=seatlock
# Host port for Postgres. 5434 avoids clashing with a other local Postgres instances (5432, 5433).
POSTGRES_PORT=5434

# --- Redis container (started now, used by the app from Phase 2) ---
REDIS_PORT=6379

# --- API (used by `make run` on your machine) ---
HTTP_ADDR=:8080
DATABASE_URL=postgres://seatlock:seatlock@localhost:5434/seatlock?sslmode=disable
RUN_MIGRATIONS=true
LOG_LEVEL=info

# --- Integration tests (`make test-integration`) ---
TEST_DATABASE_URL=postgres://seatlock:seatlock@localhost:5434/seatlock_test?sslmode=disable
