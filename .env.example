# Copy this file to .env and adjust if needed:  cp .env.example .env
# The Makefile and docker compose both read .env automatically.

# --- Postgres container ---
POSTGRES_USER=seatlock
POSTGRES_PASSWORD=seatlock
POSTGRES_DB=seatlock
# Host port for Postgres. 5434 avoids clashing with a other local Postgres instances (5432, 5433).
POSTGRES_PORT=5434

# --- Redis container (started now, used by the app from Phase 2) ---
REDIS_PORT=6379

# --- API (used by `make run` on your machine) ---
HTTP_ADDR=:8080
DATABASE_URL=postgres://seatlock:seatlock@localhost:5434/seatlock?sslmode=disable
RUN_MIGRATIONS=true
LOG_LEVEL=info
# Postgres connection pool size. Requests waiting for a free connection spend
# their query timeout while waiting, so a too-small pool causes 503s under load.
DB_MAX_CONNS=25
DB_MIN_CONNS=5
# Max time for one query or transaction, including waiting for a pool connection.
DB_QUERY_TIMEOUT=3s

# Redis seat lock. Short timeouts: if Redis does not answer fast, new holds
# fail closed with 503 instead of hanging.
REDIS_ADDR=localhost:6379
REDIS_DIAL_TIMEOUT=200ms
REDIS_READ_TIMEOUT=200ms
REDIS_WRITE_TIMEOUT=200ms
# A small, warm Redis pool: bursts wait ~1ms for an open connection instead of
# opening many new ones at once (whose first replies can exceed the timeouts).
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=10
# Database hold length, and how much longer the Redis lock lives (300s + 10s = 310s).
HOLD_TTL=300s
REDIS_LOCK_EXTRA=10s

# --- Integration tests (`make test-integration`) ---
TEST_DATABASE_URL=postgres://seatlock:seatlock@localhost:5434/seatlock_test?sslmode=disable

# --- Payment gateway client (used by the api) ---
PAYMENT_URL=http://localhost:8095
# Max time for one gateway call; on timeout the payment outcome is UNKNOWN (504).
PAYMENT_TIMEOUT=5s

# --- Mock payment gateway (cmd/payment) ---
# Host port of the mock (inside Compose the api reaches it as payment:8090).
PAYMENT_PORT=8095
# Random behaviour for demos: decline probability and answer delay.
PAYMENT_FAIL_RATE=0
PAYMENT_MIN_DELAY=0s
PAYMENT_MAX_DELAY=0s
# How long a forced "slow" charge takes.
PAYMENT_SLOW_DELAY=3s
